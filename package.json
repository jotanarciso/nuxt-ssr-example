{
  "name": "nuxt-ssr-examples",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && npm run copy:static && npm run copy:public",
    "clear:azion": "rm -rf .edge && mkdir -p .edge/storage",
    "copy:static": "npm run clear:azion && mv ./.output/public/_nuxt .edge/storage/_nuxt",
    "copy:public": "mv ./.output/public/* .edge/storage",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^2.18.7",
    "@pinia/nuxt": "^0.5.5",
    "nuxt": "^3.13.0",
    "pinia": "^2.2.4",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/eslint-config": "^0.5.7",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "typescript": "^5.6.2"
  }
}
